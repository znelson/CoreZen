// Build settings applied to Carthage dependencies (FMDB). Pass this file to
// Carthage through the XCODE_XCCONFIG_FILE environment variable:
//
//   XCODE_XCCONFIG_FILE="$PWD/Scripts/carthage.xcconfig" carthage bootstrap --use-xcframeworks --platform mac
//
// FMDB 2.7.12 targets macOS 10.11 and iOS 9.0, which Xcode 27 rejects as below
// its supported range. Carthage also builds FMDB's iOS scheme, because Xcode 27
// reports that scheme as a Mac scheme, so both values need raising.
//
// Keep the macOS value in step with CoreZen's MACOSX_DEPLOYMENT_TARGET.
MACOSX_DEPLOYMENT_TARGET = 13.0
IPHONEOS_DEPLOYMENT_TARGET = 15.0
